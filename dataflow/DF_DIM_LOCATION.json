{
	"name": "DF_DIM_LOCATION",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_DimLocation",
						"type": "DatasetReference"
					},
					"name": "sourceDimLocation"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Snowflake_DimLocation",
						"type": "DatasetReference"
					},
					"name": "sinkDimLocation"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     JOB_ID as string (\"10\"),",
				"     CREATED_DATE as date (currentDate())",
				"}",
				"source(output(",
				"          LOCATION_SK as integer,",
				"          ADDRESS as string,",
				"          LATITUDE as string,",
				"          LONGITUDE as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceDimLocation",
				"sourceDimLocation derive(JOB_ID = $JOB_ID,",
				"          CREATED_DATE = $CREATED_DATE) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true,",
				"     mapColumn(",
				"          LOCATION_SK,",
				"          ADDRESS = LATITUDE,",
				"          LATITUDE,",
				"          LONGITUDE,",
				"          JOB_ID,",
				"          CREATED_DATE",
				"     )) ~> sinkDimLocation"
			]
		}
	}
}