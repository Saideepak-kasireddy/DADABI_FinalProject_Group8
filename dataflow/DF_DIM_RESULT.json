{
	"name": "DF_DIM_RESULT",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_DimResult",
						"type": "DatasetReference"
					},
					"name": "SourceResult"
				}
			],
			"sinks": [
				{
					"name": "sinkDimResult"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     JOB_ID as string (\"10\"),",
				"     CREATED_DATE as date (currentDate())",
				"}",
				"source(output(",
				"          RESULTS as string,",
				"          RESULT_SK as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> SourceResult",
				"SourceResult derive(JOB_ID = $JOB_ID,",
				"          CREATED_DATE = $CREATED_DATE) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkDimResult"
			]
		}
	}
}