{
	"name": "DF_DIM_Violations",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_DimViolations",
						"type": "DatasetReference"
					},
					"name": "sourceDimViolation"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Snowflake_DimViolation",
						"type": "DatasetReference"
					},
					"name": "sinkDimViolations"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     JOB_ID as string (\"10\"),",
				"     CREATED_DATE as date (currentDate())",
				"}",
				"source(output(",
				"          VIOLATION_DESCRIPTION as string,",
				"          VIOLATION_CODE as string,",
				"          VIOLATION_SK as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceDimViolation",
				"sourceDimViolation derive(JOB_ID = $JOB_ID,",
				"          CREATED_DATE = $CREATED_DATE) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true,",
				"     mapColumn(",
				"          VIOLATION_DESCRIPTION,",
				"          VIOLATION_CODE,",
				"          VIOLATION_SK,",
				"          JOB_ID,",
				"          CREATED_DATE",
				"     )) ~> sinkDimViolations"
			]
		}
	}
}