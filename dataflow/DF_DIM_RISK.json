{
	"name": "DF_DIM_RISK",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Parquet_DimRisk",
						"type": "DatasetReference"
					},
					"name": "sourceDimRisk"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Snowflake_DimRisk",
						"type": "DatasetReference"
					},
					"name": "sinkDimResult"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     JOB_ID as string (\"10\"),",
				"     CREATED_DATE as date (currentDate())",
				"}",
				"source(output(",
				"          RISK as string,",
				"          RISK_SK as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> sourceDimRisk",
				"sourceDimRisk derive(JOB_ID = $JOB_ID,",
				"          CREATED_DATE = $CREATED_DATE) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     stageInsert: true,",
				"     mapColumn(",
				"          RISK,",
				"          RISK_SK,",
				"          JOB_ID,",
				"          CREATED_DATE",
				"     )) ~> sinkDimResult"
			]
		}
	}
}